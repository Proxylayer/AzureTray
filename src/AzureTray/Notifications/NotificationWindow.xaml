<Window x:Class="AzureTray.Notifications.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:notif="clr-namespace:AzureTray.Notifications"
        Title="Notification"
        Width="360"
        SizeToContent="Height"
        MinHeight="140"
        MaxHeight="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown"
        Background="Transparent"
        AllowsTransparency="True"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Family.UI}"
        FontSize="{DynamicResource Font.Size.Body}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <notif:SeverityToBrushConverter x:Key="SeverityToBrush"/>
    </Window.Resources>

    <!-- Severity drives both the perimeter colour AND a darker tinted fill,
         matching the stacked-card mockup. Drop the ConverterParameter to
         get the accent (border, title, glyph); pass "fill" to get the
         tinted background. -->
    <Border Background="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=fill}"
            BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
            BorderThickness="1.5"
            CornerRadius="{DynamicResource Radius.Large}"
            Padding="0"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              Opacity="0.55"
                              BlurRadius="16"
                              ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <!-- title / body band (message + details) / input / actions.
                     Only the body band is height-capped; the input and action
                     rows always get their natural height, so however long a
                     Message is the buttons stay on screen. -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title row: status glyph + title + dismiss. The glyph shares
                 the severity brush so the eye lands on the same accent
                 colour as the border. -->
            <Grid Grid.Row="0" Margin="14,12,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding SeverityIcon}"
                           FontSize="18"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2"
                        Content="×"
                        FontSize="16"
                        Width="22" Height="22"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource Brush.Text.Muted}"
                        Cursor="Hand"
                        Command="{Binding DismissCommand}"
                        AutomationProperties.Name="Dismiss"
                        ToolTip="Dismiss"/>
            </Grid>

            <!-- Body band: the message and the Details expander share one
                 scroll host with a hard height cap. Below the cap this is
                 invisible — the ScrollViewer sizes to its content, adds no
                 chrome (scrollbars are Auto) and the two children stack
                 exactly as the two Auto grid rows they replaced did, so an
                 ordinary short toast renders identically. Past the cap the
                 band scrolls instead of growing, which is what keeps the
                 choice list and the action buttons inside the window's
                 MaxHeight no matter how long a plugin's Message is.
                 Focusable="False" keeps it out of the tab order; the mouse
                 wheel scrolls it regardless. -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="280"
                          Focusable="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Body indents under the glyph so the message aligns with
                         the title text. -->
                    <!-- LiveSetting makes screen readers announce the toast's
                         message when it appears, without stealing focus. -->
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="42,6,14,8"/>

                    <!-- Optional collapsible Details block. Stays closed by
                         default so the notification renders compact; expanding
                         it reveals a scrollable ItemsControl of Name/Value rows
                         (exception type, HResult, response body, stack trace,
                         etc.). The Expander itself is hidden when Details is
                         empty/null. -->
                    <Expander Header="Details"
                              Margin="14,0,14,8"
                              Foreground="{DynamicResource Brush.Text.Muted}"
                              Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                        <Border BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                Background="{DynamicResource Brush.Surface.Input}"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Padding="8,6"
                                Margin="0,6,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="240">
                                <ItemsControl ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                <TextBlock Text="{Binding Value}"
                                                           TextWrapping="Wrap"
                                                           FontFamily="Consolas, Cascadia Mono, Courier New"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Choice input -->
            <StackPanel Grid.Row="2"
                        Margin="14,0,14,0"
                        Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}">
                <ListBox x:Name="ChoiceList"
                         ItemsSource="{Binding Choices}"
                         SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                         BorderBrush="{DynamicResource Brush.Border.Default}"
                         BorderThickness="1"
                         Background="{DynamicResource Brush.Surface.Input}"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         MaxHeight="120"/>
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding AllowOther, Converter={StaticResource BoolToVis}}">
                    <RadioButton x:Name="OtherRadio"
                                 Content="Other:"
                                 IsChecked="{Binding IsOtherSelected, Mode=TwoWay}"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 GroupName="NotificationOther"/>
                    <TextBox Text="{Binding OtherText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsOtherSelected}"
                             AutomationProperties.Name="Other reason"
                             Margin="20,4,0,0"
                             Padding="4,2"/>
                </StackPanel>
            </StackPanel>

            <!-- TextInput input. The request's Placeholder renders as a
                 watermark overlay (visible only while the box is empty) and
                 doubles as the box's accessible name, so a screen reader says
                 what the input is for rather than "edit, blank". -->
            <Grid Grid.Row="2"
                  Margin="14,0,14,0"
                  Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVis}}">
                <TextBox x:Name="InputBox"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding Placeholder, TargetNullValue=Response}"
                         Padding="6,4"/>
                <TextBlock Text="{Binding Placeholder}"
                           IsHitTestVisible="False"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Muted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Action buttons -->
            <Grid Grid.Row="3" Margin="14,12,14,14">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="{Binding IsYesNo, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="YesButton"
                            Content="_Yes"
                            Width="80"
                            Padding="0,4"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Command="{Binding YesCommand}"/>
                    <Button Content="_No"
                            Width="80"
                            Padding="0,4"
                            IsCancel="True"
                            Command="{Binding NoCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="{Binding IsSubmittable, Converter={StaticResource BoolToVis}}">
                    <Button Content="_Submit"
                            Width="80"
                            Padding="0,4"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Command="{Binding SubmitCommand}"/>
                    <Button Content="_Cancel"
                            Width="80"
                            Padding="0,4"
                            IsCancel="True"
                            Command="{Binding DismissCommand}"/>
                </StackPanel>
                <!-- Single-action call-to-action (ActionRequest). Primary
                     button uses the severity colour so e.g. "Update now"
                     reads as blue. No access-key mnemonic: the label comes
                     from the plugin's request (ActionLabel), so there is no
                     literal to place an underscore in. -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="{Binding IsAction, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="ActionButton"
                            Content="{Binding ActionLabel}"
                            MinWidth="100"
                            Padding="10,4"
                            IsDefault="True"
                            FontWeight="SemiBold"
                            Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                            BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                            Foreground="{DynamicResource Brush.Text.Inverse}"
                            Command="{Binding InvokeActionCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
