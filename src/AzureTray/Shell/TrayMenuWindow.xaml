<Window x:Class="AzureTray.Shell.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:contracts="clr-namespace:AzureTray.Plugin.Contracts;assembly=AzureTray.Plugin.Contracts"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowActivated="True"
        Focusable="True"
        KeyDown="OnKeyDown"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <!-- Shared item template for a single menu row. Renders either a
             6px transparent spacer (separator) or a full row with the
             3-column grid [icon][text][chevron/shortcut].

             IsBusy items get the rotating ◐/◓/◑/◒ glyph through a
             Storyboard targeting the SpinnerText TextBlock — the rest of
             the menu stays still, no full-row redraw. -->
        <Style x:Key="TrayMenuRow" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <!-- UIA name: without this the ListItem peer surfaces the record's
                 ToString() (type name + property dump) to screen readers. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Busy rows announce their refreshing state to assistive tech. -->
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="AutomationProperties.HelpText" Value="refreshing"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type contracts:PluginMenuItem}">
            <Grid x:Name="Root" Cursor="Hand">
                <!-- Separator path: 6px transparent spacer. The Grid stays
                     in the layout but only this child is visible. -->
                <Border x:Name="SeparatorSpacer" Height="6" Visibility="Collapsed"/>

                <!-- Item path: row content. Plugin-provided icon (if any)
                     gets its own slot so we can animate it for IsBusy. -->
                <Grid x:Name="ItemContent" Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Icon slot. Width auto so items without an icon
                         don't waste column space; the gap is achieved via
                         the icon's right margin. -->
                    <TextBlock x:Name="IconText"
                               Grid.Column="0"
                               Text="{Binding Icon}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="LabelText"
                               Grid.Column="1"
                               Text="{Binding Text}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <!-- Favorite star. A real focusable ToggleButton so keyboard
                         users can Tab/arrow to it and Space-toggle; its Click
                         handler toggles without firing the row's primary action
                         (ButtonBase handles the mouse events, so they never
                         reach the ListBox's row-invoke handler). Transparent
                         chrome keeps the visuals identical to the old TextBlock:
                         empty ☆ by default, filled accent ★ when IsFavorite is
                         true, inverse foreground on the accent hover/selection
                         fill for contrast. Hidden on rows where IsFavorite is
                         null. -->
                    <ToggleButton x:Name="FavoriteStar"
                                  Grid.Column="2"
                                  Margin="10,0,0,0"
                                  Cursor="Hand"
                                  Focusable="True"
                                  Click="OnFavoriteStarClick"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding ShowFavorite, Converter={StaticResource BoolToVisibility}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="AutomationProperties.Name" Value="Add to favorites"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="6,0">
                                                <TextBlock x:Name="StarGlyph"
                                                           Text="&#x2606;"
                                                           FontSize="15"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter TargetName="StarGlyph" Property="Text" Value="&#x2605;"/>
                                                    <Setter TargetName="StarGlyph" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                </DataTrigger>
                                                <!-- Contrast: on the accent row fill the muted/accent
                                                     glyph is ~1.3:1; switch to the inverse text brush.
                                                     Declared after the IsFavorite trigger so it wins
                                                     while the row is hovered/selected. -->
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="StarGlyph" Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="StarGlyph" Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="AutomationProperties.Name" Value="Remove from favorites"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock x:Name="Chevron"
                               Grid.Column="3"
                               Text="&#x25B6;"
                               FontSize="10"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter TargetName="SeparatorSpacer" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ItemContent" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Root" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="Root" Property="Cursor" Value="Arrow"/>
                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                </DataTrigger>

                <!-- Contrast: the muted chevron is near-invisible (~1.3:1) on
                     the accent hover/selection fill — switch it to the inverse
                     text brush while the row carries that fill. (The favorite
                     star handles the same case inside its own template.)
                     The main label swaps too: a no-op in the dark theme
                     (Inverse == Primary), but under High Contrast it pairs
                     HighlightText with the Highlight row fill. IconText is
                     deliberately left alone — the IsBusy storyboard animates
                     its Foreground brush in place. -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}"/>
                    <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}"/>
                    <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}"/>
                </DataTrigger>

                <!-- IsBusy: cycle the icon glyph through ◐ ◓ ◑ ◒ on a
                     480ms loop. ObjectAnimationUsingKeyFrames animates the
                     Text property directly — no rotation transform needed
                     so the spinner reads cleanly at any font size and looks
                     identical to the inline glyph the legacy WinForms menu
                     used. ExitActions stop the storyboard so Text reverts
                     to the bound Icon value when the poll finishes. -->
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinStory">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames
                                    Storyboard.TargetName="IconText"
                                    Storyboard.TargetProperty="Text">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.00" Value="◐"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="◓"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.24" Value="◑"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.36" Value="◒"/>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.48" Value="◐"/>
                                </ObjectAnimationUsingKeyFrames>
                                <ColorAnimation
                                    Storyboard.TargetName="IconText"
                                    Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                    To="{StaticResource Color.Accent}"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinStory"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Bordered surface with subtle drop shadow, rounded corners. The
         Border IS the menu — the Window itself is transparent so we get
         proper rounded edges without OS chrome. -->
    <Border Background="{DynamicResource Brush.Surface.Panel}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Large}"
            MinWidth="280"
            MaxWidth="520"
            Padding="0,4"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              Opacity="0.55"
                              BlurRadius="16"
                              ShadowDepth="2"/>
        </Border.Effect>

        <DockPanel LastChildFill="True">
            <!-- Search box at the top of searchable submenus. Hidden when
                 the menu wasn't constructed with a SearchProvider. -->
            <Grid DockPanel.Dock="Top"
                  Margin="6,4,6,4"
                  Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">
                <TextBox x:Name="SearchBox"
                         AutomationProperties.Name="Search"
                         TextChanged="OnSearchTextChanged"/>
                <!-- Placeholder overlay: visible only when SearchBox is empty
                     AND not focused. Hit-test invisible so clicks pass to
                     the TextBox beneath. -->
                <TextBlock Text="{Binding SearchPlaceholder}"
                           IsHitTestVisible="False"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Muted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Three-row grid sandwiches the ListBox between scroll
                 indicators. Borders are collapsed by default; the
                 code-behind locates the ListBox's internal ScrollViewer
                 on load and shows/hides each arrow based on
                 VerticalOffset / ScrollableHeight (matches the legacy
                 Azure.PIM.Tray ScrollUpArrow / ScrollDownArrow pattern).
                 Hovering an arrow starts a 50ms DispatcherTimer that
                 scrolls 40 DIP per tick until the cursor leaves. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="ScrollUpArrow"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Background="{DynamicResource Brush.Surface.Panel}"
                        Padding="0,3"
                        Cursor="Hand"
                        MouseEnter="OnScrollUpArrowMouseEnter"
                        MouseLeave="OnScrollArrowMouseLeave">
                    <TextBlock Text="&#x25B2;"
                               FontSize="8"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               HorizontalAlignment="Center"/>
                </Border>

                <ListBox x:Name="ItemsList"
                         Grid.Row="1"
                         ItemsSource="{Binding Items}"
                         ItemContainerStyle="{StaticResource TrayMenuRow}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MaxHeight="500"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         KeyboardNavigation.DirectionalNavigation="Cycle"
                         MouseLeftButtonUp="OnItemMouseLeftButtonUp"
                         MouseRightButtonUp="OnItemMouseRightButtonUp"
                         Loaded="OnItemsListLoaded"/>

                <Border x:Name="ScrollDownArrow"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Background="{DynamicResource Brush.Surface.Panel}"
                        Padding="0,3"
                        Cursor="Hand"
                        MouseEnter="OnScrollDownArrowMouseEnter"
                        MouseLeave="OnScrollArrowMouseLeave">
                    <TextBlock Text="&#x25BC;"
                               FontSize="8"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
